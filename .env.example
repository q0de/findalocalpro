# Set to "true" to enable direct contact buttons on provider profile pages
# When false (default), shows "Get a Free Quote" redirect to chat flow
NEXT_PUBLIC_DIRECT_CONTACT_ENABLED=false

# Perplexity API key for quote estimation
PERPLEXITY_API_KEY=

# Stripe Checkout for /partners
STRIPE_SECRET_KEY=
# Optional: leave blank to use inline $497/mo founding partner checkout pricing
STRIPE_PARTNER_MONTHLY_PRICE_ID=
STRIPE_PARTNER_SETUP_PRICE_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to enable direct contact buttons on provider profile pages
# When false (default), shows "Get a Free Quote" redirect to chat flow
NEXT_PUBLIC_DIRECT_CONTACT_ENABLED=false

# Perplexity API key for quote estimation
PERPLEXITY_API_KEY=

# Stripe Checkout for applications that have already been approved
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PARTNER_FOUNDING_PRICE_ID=
STRIPE_PARTNER_STANDARD_PRICE_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase access for partner applications and billing state
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Application review alerts and signed one-use action links
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PARTNER_REVIEW_TOKEN_SECRET=

# Email the private Stripe checkout link after approval
RESEND_API_KEY=
PARTNER_FROM_EMAIL=FindALocalPro <partners@findalocalpro.com>
